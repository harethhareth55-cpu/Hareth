rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(storeId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid));
    }

    // بريد المسؤول الوحيد المخوّل يدير الاشتراكات — عدّله لبريدك إذا تغيّر
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'harethhareth55@gmail.com';
    }

    // كل مستخدم يقرأ ويكتب مستند بياناته الخاص بس (فيه storeId المرتبط فيه)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /stores/{storeId} {
      // get: أي مستخدم مسجّل يقرأ محل وحد (يحتاجها للتحقق من كود المحل قبل الانضمام)
      allow get: if request.auth != null;
      // list: فقط المسؤول (لوحة الإدارة تحتاج تعرض كل المحلات)
      allow list: if isAdmin();
      allow update: if isMember(storeId) || isAdmin();
      allow create: if request.auth != null;

      match /members/{uid} {
        allow read: if isMember(storeId);
        // أي مستخدم مسجل يقدر يضيف نفسه كعضو (هذا هو آلية "الانضمام بالكود")
        allow create: if request.auth != null && request.auth.uid == uid;
      }

      match /products/{productId} {
        allow read, write: if isMember(storeId);
      }

      match /sales/{saleId} {
        allow read, write: if isMember(storeId);
      }
    }

    // طلبات إثبات دفع الاشتراك: أي عضو بمحل يقدر يرسل طلب لمحله، وبس المسؤول يقرأ/يوافق عليها
    match /subscriptionRequests/{requestId} {
      allow create: if request.auth != null && isMember(request.resource.data.storeId);
      allow read, update: if isAdmin();
    }
  }
}
